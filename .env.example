# Local development only. Copy to .env; never put real secrets here.

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# API
PORT=8000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=20000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
# Must be at least MIN_HTTP_DRAIN_MS + DB_CONNECTION_TIMEOUT_MS +
# DB_STATEMENT_TIMEOUT_MS + 4 s, and stay below the container's stop grace
# period (docker stop waits 10 s by default)
SHUTDOWN_TIMEOUT_MS=20000

# GitHub App (Settings > Developer settings > GitHub Apps > your app)
# The private key stays outside the repository, readable only by you
# (chmod 600). Generate the webhook secret with: openssl rand -hex 32
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/Users/you/.config/scryguard/app.private-key.pem
GITHUB_APP_WEBHOOK_SECRET=change-me

# PostgreSQL
DB_PORT=5432
DB_USER=scryguard
DB_PASSWORD=scryguard-local
DB_NAME=scryguard
DATABASE_URL=postgres://scryguard:scryguard-local@127.0.0.1:5432/scryguard
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_READINESS_TIMEOUT_MS=1000
DB_STATEMENT_TIMEOUT_MS=5000

# Redis (REDIS_URL holds the password: never log it)
REDIS_PORT=6380
REDIS_PASSWORD=scryguard-local
REDIS_URL=redis://default:scryguard-local@127.0.0.1:6380/0
REDIS_COMMAND_TIMEOUT_MS=100
REDIS_CONNECT_TIMEOUT_MS=2000

# SQS (ElasticMQ locally; on AWS the endpoint is left unset)
SQS_PORT=9324
SQS_ENDPOINT=http://127.0.0.1:9324

# S3 (RustFS locally; on AWS the endpoint and keys are left unset)
S3_PORT=9020
S3_ENDPOINT=http://127.0.0.1:9020
S3_REGION=us-east-1
S3_BUCKET=sandbox-results
S3_ACCESS_KEY_ID=scryguard
S3_SECRET_ACCESS_KEY=scryguard-local-secret

# Ollama runs on the GPU PC on the local network, outside Compose. Use the
# PC's LAN address. Check it answers:
#   curl -fsS "$OLLAMA_BASE_URL/api/version"
OLLAMA_BASE_URL=http://192.168.1.50:11434
