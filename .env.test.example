NODE_ENV=test
LOG_LEVEL=silent

# Test PostgreSQL
TEST_DB_PORT=5461
TEST_DB_USER=scryguard_test
TEST_DB_PASSWORD=scryguard-test-only
TEST_DB_NAME=scryguard_test
TEST_DATABASE_URL=postgres://scryguard_test:scryguard-test-only@127.0.0.1:5461/scryguard_test

# Test Redis
TEST_REDIS_PORT=6411
TEST_REDIS_PASSWORD=scryguard-test-only
TEST_REDIS_URL=redis://default:scryguard-test-only@127.0.0.1:6411/0

# Test SQS (ElasticMQ)
TEST_SQS_PORT=9334
TEST_SQS_ENDPOINT=http://127.0.0.1:9334

# Test S3 (RustFS)
TEST_S3_PORT=9030
TEST_S3_ENDPOINT=http://127.0.0.1:9030
TEST_S3_REGION=us-east-1
TEST_S3_BUCKET=sandbox-results
TEST_S3_ACCESS_KEY_ID=scryguard-test
TEST_S3_SECRET_ACCESS_KEY=scryguard-test-only

# Toxiproxy: failure tests connect through these URLs and inject faults via the API
TEST_TOXIPROXY_URL=http://127.0.0.1:8475
TEST_TOXIPROXY_DATABASE_URL=postgres://scryguard_test:scryguard-test-only@127.0.0.1:5462/scryguard_test
TEST_TOXIPROXY_REDIS_URL=redis://default:scryguard-test-only@127.0.0.1:6412/0
