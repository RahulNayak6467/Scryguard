{
  "name": "@scryguard/api",
  "version": "0.0.0",
  "private": true,
  "description": "Scryguard HTTP API",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --conditions=@scryguard/source --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --passWithNoTests apps/api/",
    "openapi:generate": "node --conditions=@scryguard/source --import tsx scripts/generate-openapi.ts && prettier --write --log-level warn openapi.json"
  },
  "dependencies": {
    "@scryguard/config": "workspace:*",
    "@scryguard/database": "workspace:*",
    "@scryguard/logger": "workspace:*",
    "@scryguard/redis": "workspace:*",
    "@scryguard/shared": "workspace:*",
    "express": "5.3.0",
    "zod": "catalog:",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2"
  }
}
